# Envoi du formulaire de contact (SMTP). Copiez ce fichier en .env.local et remplissez les valeurs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
# Gmail : mot de passe d'application (pas votre mot de passe habituel)
SMTP_PASS=
# Adresse qui reçoit les demandes
MAIL_TO=
# Optionnel : expéditeur affiché, ex. "Site Fusion Leap" <contact@fusionleap.ma>
MAIL_FROM=

# URL publique du site (SEO : sitemap, balises canoniques, Open Graph)
NEXT_PUBLIC_SITE_URL=https://fusionleap.ma
